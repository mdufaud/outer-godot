#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer DirectionBuffer {
	float values[];
} directions;

layout(std430, set = 0, binding = 1) writeonly buffer HeightBuffer {
	float values[];
} heights;

struct Crater {
	vec4 centre_radius;
	vec4 floor_smoothness;
};

layout(std430, set = 0, binding = 2) readonly buffer CraterBuffer {
	Crater values[];
} craters;

layout(std430, set = 0, binding = 3) readonly buffer SettingBuffer {
	vec4 values[];
} settings;

struct Spike {
	vec4 direction_height;
	vec4 shape;
};

layout(std430, set = 0, binding = 4) readonly buffer SpikeBuffer {
	Spike values[];
} spikes;

layout(push_constant, std430) uniform Parameters {
	ivec4 counts;
} parameters;

vec3 mod289(vec3 value) {
	return value - floor(value / 289.0) * 289.0;
}

vec4 mod289(vec4 value) {
	return value - floor(value / 289.0) * 289.0;
}

vec4 permute(vec4 value) {
	return mod289((value * 34.0 + 1.0) * value);
}

vec4 taylor_inverse_sqrt(vec4 value) {
	return 1.79284291400159 - value * 0.85373472095314;
}

float simplex_noise(vec3 position) {
	const vec2 coefficients = vec2(1.0 / 6.0, 1.0 / 3.0);
	vec3 lattice = floor(position + dot(position, coefficients.yyy));
	vec3 corner0 = position - lattice + dot(lattice, coefficients.xxx);
	vec3 greater = step(corner0.yzx, corner0.xyz);
	vec3 lower = 1.0 - greater;
	vec3 corner1 = min(greater.xyz, lower.zxy);
	vec3 corner2 = max(greater.xyz, lower.zxy);
	vec3 position1 = corner0 - corner1 + coefficients.xxx;
	vec3 position2 = corner0 - corner2 + coefficients.yyy;
	vec3 position3 = corner0 - 0.5;
	lattice = mod289(lattice);
	vec4 permutations = permute(permute(permute(lattice.z + vec4(0.0, corner1.z, corner2.z, 1.0))
		+ lattice.y + vec4(0.0, corner1.y, corner2.y, 1.0))
		+ lattice.x + vec4(0.0, corner1.x, corner2.x, 1.0));
	vec4 hashes = permutations - 49.0 * floor(permutations / 49.0);
	vec4 x_index = floor(hashes / 7.0);
	vec4 y_index = floor(hashes - 7.0 * x_index);
	vec4 x = (x_index * 2.0 + 0.5) / 7.0 - 1.0;
	vec4 y = (y_index * 2.0 + 0.5) / 7.0 - 1.0;
	vec4 h = 1.0 - abs(x) - abs(y);
	vec4 base0 = vec4(x.xy, y.xy);
	vec4 base1 = vec4(x.zw, y.zw);
	vec4 sign0 = floor(base0) * 2.0 + 1.0;
	vec4 sign1 = floor(base1) * 2.0 + 1.0;
	vec4 selector = -step(h, vec4(0.0));
	vec4 adjusted0 = base0.xzyw + sign0.xzyw * selector.xxyy;
	vec4 adjusted1 = base1.xzyw + sign1.xzyw * selector.zzww;
	vec3 gradient0 = vec3(adjusted0.xy, h.x);
	vec3 gradient1 = vec3(adjusted0.zw, h.y);
	vec3 gradient2 = vec3(adjusted1.xy, h.z);
	vec3 gradient3 = vec3(adjusted1.zw, h.w);
	vec4 normalization = taylor_inverse_sqrt(vec4(dot(gradient0, gradient0), dot(gradient1, gradient1), dot(gradient2, gradient2), dot(gradient3, gradient3)));
	gradient0 *= normalization.x;
	gradient1 *= normalization.y;
	gradient2 *= normalization.z;
	gradient3 *= normalization.w;
	vec4 attenuation = max(0.6 - vec4(dot(corner0, corner0), dot(position1, position1), dot(position2, position2), dot(position3, position3)), 0.0);
	attenuation *= attenuation;
	attenuation *= attenuation;
	return 42.0 * dot(attenuation, vec4(dot(corner0, gradient0), dot(position1, gradient1), dot(position2, gradient2), dot(position3, gradient3)));
}

float smooth_minimum(float a, float b, float smoothing) {
	float k = max(0.0001, smoothing);
	float h = clamp((b - a + k) / (2.0 * k), 0.0, 1.0);
	return a * h + b * (1.0 - h) - k * h * (1.0 - h);
}

float smooth_maximum(float a, float b, float smoothing) {
	float k = min(-0.0001, -smoothing);
	float h = clamp((b - a + k) / (2.0 * k), 0.0, 1.0);
	return a * h + b * (1.0 - h) - k * h * (1.0 - h);
}

float simple_noise(vec3 position, int index) {
	vec4 first = settings.values[index];
	vec4 second = settings.values[index + 1];
	vec4 third = settings.values[index + 2];
	float sum = 0.0;
	float amplitude = 1.0;
	float frequency = second.z;
	for (int layer = 0; layer < int(first.w); layer++) {
		sum += simplex_noise(position * frequency + first.xyz) * amplitude;
		amplitude *= second.x;
		frequency *= second.y;
	}
	return sum * second.w + third.x;
}

float ridge_noise(vec3 position, int index) {
	vec4 first = settings.values[index];
	vec4 second = settings.values[index + 1];
	vec4 third = settings.values[index + 2];
	float sum = 0.0;
	float amplitude = 1.0;
	float frequency = second.z;
	float weight = 1.0;
	for (int layer = 0; layer < int(first.w); layer++) {
		float value = 1.0 - abs(simplex_noise(position * frequency + first.xyz));
		value = pow(abs(value), third.x);
		value *= weight;
		weight = clamp(value * third.y, 0.0, 1.0);
		sum += value * amplitude;
		amplitude *= second.x;
		frequency *= second.y;
	}
	return sum * second.w + third.z;
}

float smoothed_ridge_noise(vec3 position, int index) {
	vec3 normal = normalize(position);
	vec3 axis_a = cross(normal, vec3(0.0, 1.0, 0.0));
	vec3 axis_b = cross(normal, axis_a);
	float offset = settings.values[index + 2].w * 0.01;
	return (
		ridge_noise(position, index)
		+ ridge_noise(position - axis_a * offset, index)
		+ ridge_noise(position + axis_a * offset, index)
		+ ridge_noise(position - axis_b * offset, index)
		+ ridge_noise(position + axis_b * offset, index)
	) * 0.2;
}

float crater_depth(vec3 position) {
	vec4 config = settings.values[19];
	float height = 0.0;
	for (int index = 0; index < parameters.counts.z; index++) {
		Crater crater = craters.values[index];
		float distance_to_crater = length(position - crater.centre_radius.xyz) / max(crater.centre_radius.w, 0.0001);
		float cavity = distance_to_crater * distance_to_crater - 1.0;
		float rim_x = min(distance_to_crater - 1.0 - config.y, 0.0);
		float rim = config.x * rim_x * rim_x;
		float crater_shape = smooth_maximum(cavity, crater.floor_smoothness.x, crater.floor_smoothness.y);
		crater_shape = smooth_minimum(crater_shape, rim, crater.floor_smoothness.y);
		height += crater_shape * crater.centre_radius.w;
	}
	return height;
}

float earth_height(vec3 position) {
	vec4 config = settings.values[9];
	float continent = simple_noise(position, 0);
	continent = smooth_maximum(continent, -config.y, config.z);
	if (continent < 0.0) {
		continent *= 1.0 + config.x;
	}
	float ridge = smoothed_ridge_noise(position, 6);
	float mask = smoothstep(-config.w * 0.5, config.w * 0.5, simple_noise(position, 3));
	return 1.0 + continent * 0.01 + ridge * 0.01 * mask;
}

// Ice spires welded into the heightfield. Each one is a narrow lobe of the
// direction sphere raised by a high power of the alignment, so the mesh grows a
// real spike instead of carrying decoration geometry. Taking the maximum lets
// neighbours merge into a ridge rather than stacking into a lump.
float spike_height(vec3 position) {
	vec3 direction = normalize(position);
	float height = 0.0;
	for (int index = 0; index < parameters.counts.w; index++) {
		Spike spike = spikes.values[index];
		float alignment = max(dot(direction, spike.direction_height.xyz), 0.0);
		float needle = pow(alignment, spike.shape.x);
		// The taper is thinned near the tip so the spire ends as a point.
		needle *= mix(1.0, needle, spike.shape.y);
		height = max(height, spike.direction_height.w * needle);
	}
	return height;
}

float moon_height(vec3 position) {
	float shape = simple_noise(position, 10);
	float ridge = smoothed_ridge_noise(position, 13);
	float ridge2 = smoothed_ridge_noise(position, 16);
	return 1.0 + crater_depth(position) + (shape + ridge + ridge2) * 0.01 + spike_height(position);
}

float alien_height(vec3 position) {
	vec3 warp = vec3(
		simple_noise(position, 9),
		simple_noise(position - 100.0, 9),
		simple_noise(position + 100.0, 9)
	) * 0.01;
	vec4 config = settings.values[18];
	vec4 profile = settings.values[17];
	float continent = simple_noise(position + warp * profile.x, 0);
	continent = smooth_maximum(continent, -config.y, config.z);
	if (continent < 0.0) {
		continent *= 1.0 + config.x;
	}
	float ridge = smoothed_ridge_noise(position + warp * profile.y, 6);
	float mask = smoothstep(-config.w * 0.5, config.w * 0.5, simple_noise(position + warp * profile.z, 3));
	return 1.0 + continent * 0.01 + ridge * 0.01 * mask + crater_depth(position);
}

// Quantises the elevation into terraces: the lower half of each band is a flat
// plateau, the upper half a wall. A small sharpness makes that wall vertical,
// which is what reads as a canyon rim instead of a rounded ridge.
float terrace_elevation(float elevation, vec4 terrace) {
	float scaled = elevation * terrace.x;
	float level = floor(scaled);
	float t = scaled - level;
	float stepped = (level + smoothstep(0.5 - terrace.y, 0.5 + terrace.y, t)) / terrace.x;
	return mix(elevation, stepped, terrace.z);
}

float mirage_height(vec3 position) {
	vec3 warp = vec3(
		simple_noise(position, 9),
		simple_noise(position - 100.0, 9),
		simple_noise(position + 100.0, 9)
	) * 0.01;
	vec4 config = settings.values[18];
	vec4 profile = settings.values[17];
	float continent = simple_noise(position + warp * profile.x, 0);
	continent = smooth_maximum(continent, -config.y, config.z);
	if (continent < 0.0) {
		continent *= 1.0 + config.x;
	}
	float ridge = smoothed_ridge_noise(position + warp * profile.y, 6);
	float mask = smoothstep(-config.w * 0.5, config.w * 0.5, simple_noise(position + warp * profile.z, 3));
	float elevation = terrace_elevation(continent + ridge * mask, settings.values[12]);
	return 1.0 + elevation * 0.01 + crater_depth(position);
}

float shattered_height(vec3 position) {
	vec3 warp = vec3(
		simple_noise(position, 9),
		simple_noise(position - 100.0, 9),
		simple_noise(position + 100.0, 9)
	) * 0.01;
	vec4 config = settings.values[18];
	float continent = smooth_minimum(simple_noise(position + warp, 0), config.x, config.y);
	float ridge = smoothed_ridge_noise(position, 3);
	float ridge2 = smoothed_ridge_noise(position, 6);
	return 1.0 + (continent + ridge + ridge2) * 0.01 + crater_depth(position);
}

float moat_height(vec3 position) {
	vec4 config = settings.values[18];
	float continent = simple_noise(position, 0);
	continent *= 1.0 + continent / config.y * config.x;
	if (continent < 0.0) {
		continent *= 1.0 + config.w * abs(continent);
	}
	return 1.0 + continent * 0.01 + crater_depth(position);
}

float ridged_fbm(vec3 position, int layers, float lacunarity, float persistence, float scale) {
	float noise = 0.0;
	float frequency = scale / 100.0;
	float amplitude = 1.0;
	for (int layer = 0; layer < layers; layer++) {
		float value = 1.0 - abs(simplex_noise(position * frequency) * 2.0 - 1.0);
		noise += value * amplitude;
		amplitude *= persistence;
		frequency *= lacunarity;
	}
	return noise;
}

float asteroid_height(vec3 position) {
	vec4 shape = settings.values[0];
	vec4 terrain = settings.values[1];
	float surface_radius = 18.0;
	for (int iteration = 0; iteration < 4; iteration++) {
		float noise = ridged_fbm(position * surface_radius, int(shape.x), shape.y, shape.z, shape.w);
		surface_radius = 18.0 - (noise - terrain.y) * terrain.x;
	}
	return surface_radius / 18.0;
}

float glacier_height(vec3 position) {
	vec4 shape = settings.values[0];
	vec4 terrain = settings.values[1];
	float surface_radius = 24.0;
	for (int iteration = 0; iteration < 4; iteration++) {
		float noise = ridged_fbm(position * surface_radius, int(shape.x), shape.y, shape.z, shape.w);
		surface_radius = 24.0 - (noise - terrain.y) * terrain.x;
	}
	return surface_radius / 24.0;
}

void main() {
	uint index = gl_GlobalInvocationID.x;
	if (index >= uint(parameters.counts.x)) {
		return;
	}
	vec3 position = vec3(directions.values[index * 3u], directions.values[index * 3u + 1u], directions.values[index * 3u + 2u]);
	switch (parameters.counts.y) {
		case 1:
			heights.values[index] = moon_height(position);
			break;
		case 2:
			heights.values[index] = alien_height(position);
			break;
		case 3:
			heights.values[index] = shattered_height(position);
			break;
		case 4:
			heights.values[index] = moat_height(position);
			break;
		case 5:
			heights.values[index] = asteroid_height(position);
			break;
		case 6:
			heights.values[index] = glacier_height(position);
			break;
		case 7:
			heights.values[index] = mirage_height(position);
			break;
		default:
			heights.values[index] = earth_height(position);
	}
}
